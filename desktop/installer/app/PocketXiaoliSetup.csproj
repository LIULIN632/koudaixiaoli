<Project Sdk="Microsoft.NET.Sdk">

  <!-- 单文件安装程序：把 payload.zip 作为嵌入资源打进 EXE，运行时解压安装。
       payload.zip 由 tools\installer.ps1 在 publish 前放进来（.gitignore 忽略）。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PocketXiaoliSetup</AssemblyName>
    <RootNamespace>PocketXiaoli.Setup</RootNamespace>
    <ApplicationIcon>..\..\docs\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <!-- 版本号由 tools/installer.ps1 用 -p:Version 传入（真源是仓库根 gradle.properties）；这里只做兜底 -->
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <Product>口袋小鲤 桌面版</Product>
    <Company>Pocket Xiaoli</Company>
    <AssemblyTitle>口袋小鲤 · 桌面版 安装程序</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')" />
  </ItemGroup>

</Project>
