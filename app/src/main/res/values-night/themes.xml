<?xml version="1.0" encoding="utf-8"?>
<!-- 深色窗口主题：图标切成浅色（windowLightStatusBar=false），底色与深色页面底色同值。 -->
<resources>
    <style name="Theme.PocketXiaoli" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/status_bar</item>
        <item name="android:windowBackground">@color/status_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>